{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksVersion": "1.29.1", 
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter counter-app build"
  },
  "deploy": {
    "startCommand": "pnpm --filter counter-app start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
